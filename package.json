{
  "name": "starmap-plugin",
  "private": true,
  "version": "1.5.5",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify:package": "node scripts/verify-package.mjs",
    "test:team-sync": "node --test tests/team-sync.test.mjs",
    "test:team-sync-ui": "node tests/team-sync-ui.mjs",
    "test:network": "node --test --test-concurrency=1 tests/network-sync.test.mjs tests/host-network.test.mjs tests/host-http-redirects.test.mjs tests/desktop-backend.test.mjs",
    "test:ring": "node --test tests/ring-connect.test.mjs",
    "test:activity": "node --test tests/activity-reminders.test.mjs",
    "test:activity-ui": "node tests/activity-ui.mjs",
    "test:autosync": "node --test --test-concurrency=1 tests/auto-sync.test.mjs tests/host-storage.test.mjs",
    "test:autosync-ui": "node tests/auto-sync-ui.mjs",
    "test:geometry": "node --test tests/placement.test.mjs",
    "test:branches": "node --test tests/branch-sync.test.mjs tests/gitlab-compat.test.mjs",
    "test:shared-join": "node --test tests/shared-connection.test.mjs",
    "test:shared-tracks": "node --test tests/shared-tracks.test.mjs",
    "test:shared-tracks-ui": "node tests/shared-tracks-ui.mjs",
    "prepare:real-connection": "node scripts/prepare-real-connection.mjs",
    "test:desktop-integration": "node tests/desktop-integration.mjs",
    "test:desktop-stability": "node tests/desktop-integration.mjs --stability",
    "check": "npm run typecheck && npm run test:team-sync && npm run test:network && npm run test:ring && npm run test:activity && npm run test:autosync && npm run test:geometry && npm run test:track && npm run test:branches && npm run test:shared-join && npm run test:shared-tracks && npm run build && npm run verify:package",
    "test:track": "node --test tests/beings-track.test.mjs"
  },
  "dependencies": {
    "@xyflow/react": "12.11.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@beings/grove-plugin-sdk": "file:vendor/grove-plugin-sdk",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.25.0",
    "tar": "^7.5.22",
    "typescript": "^5.9.3"
  },
  "description": "用站、节点和闸口编排星轨，在星图中通过 Being 对话协作推进任务。",
  "repository": {
    "type": "git",
    "url": "https://github.com/chunqing-liu/starmap.git"
  },
  "engines": {
    "node": ">=22.12"
  }
}
